{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "base-linux",
            "hidden": true,
            "inherits": "base"
        },
        {
            "name": "debug-linux",
            "displayName": "Debug Linux",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-tidy-linux",
            "displayName": "Clang-Tidy Linux (partial coverage)",
            "inherits": "debug-linux"
        },
        {
            "name": "release-linux",
            "displayName": "Release Linux",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "sanitize-linux",
            "displayName": "Linux Address/Undefined Behavior Sanitizers",
            "inherits": "debug-linux",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "h755-io-debug",
            "displayName": "NUCLEO-H755ZI-Q CM4 IO application (debug)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H755_CORE": "CM4",
                "H755_LED_SAMPLE": false,
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "h755-ui-debug",
            "displayName": "NUCLEO-H755ZI-Q CM7 UI application (debug)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H755_CORE": "CM7",
                "H755_LED_SAMPLE": false,
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "h755-io-release",
            "displayName": "NUCLEO-H755ZI-Q CM4 IO application (release)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "H755_CORE": "CM4",
                "H755_LED_SAMPLE": false,
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "h755-ui-release",
            "displayName": "NUCLEO-H755ZI-Q CM7 UI application (release)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "H755_CORE": "CM7",
                "H755_LED_SAMPLE": false,
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "h755-led-io-debug",
            "displayName": "NUCLEO-H755ZI-Q CM4 IO LED sample (debug)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H755_CORE": "CM4",
                "H755_LED_SAMPLE": true
            }
        },
        {
            "name": "h755-led-ui-debug",
            "displayName": "NUCLEO-H755ZI-Q CM7 UI LED sample (debug)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H755_CORE": "CM7",
                "H755_LED_SAMPLE": true
            }
        },
        {
            "name": "h755-led-io-release",
            "displayName": "NUCLEO-H755ZI-Q CM4 IO LED sample (release)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "H755_CORE": "CM4",
                "H755_LED_SAMPLE": true
            }
        },
        {
            "name": "h755-led-ui-release",
            "displayName": "NUCLEO-H755ZI-Q CM7 UI LED sample (release)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "H755_CORE": "CM7",
                "H755_LED_SAMPLE": true
            }
        },
        {
            "name": "h755-debug",
            "displayName": "NUCLEO-H755ZI-Q IO + UI applications (debug)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "H755_BUILD_BOTH": true
            }
        },
        {
            "name": "h755-release",
            "displayName": "NUCLEO-H755ZI-Q IO + UI applications (release)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "H755_BUILD_BOTH": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-linux",
            "configurePreset": "debug-linux"
        },
        {
            "name": "clang-tidy-linux",
            "configurePreset": "clang-tidy-linux",
            "targets": [
                "clang-tidy"
            ]
        },
        {
            "name": "release-linux",
            "configurePreset": "release-linux"
        },
        {
            "name": "sanitize-linux",
            "configurePreset": "sanitize-linux"
        },
        {
            "name": "h755-io-debug",
            "configurePreset": "h755-io-debug"
        },
        {
            "name": "h755-ui-debug",
            "configurePreset": "h755-ui-debug"
        },
        {
            "name": "h755-io-release",
            "configurePreset": "h755-io-release"
        },
        {
            "name": "h755-ui-release",
            "configurePreset": "h755-ui-release"
        },
        {
            "name": "h755-led-io-debug",
            "configurePreset": "h755-led-io-debug"
        },
        {
            "name": "h755-led-ui-debug",
            "configurePreset": "h755-led-ui-debug"
        },
        {
            "name": "h755-led-io-release",
            "configurePreset": "h755-led-io-release"
        },
        {
            "name": "h755-led-ui-release",
            "configurePreset": "h755-led-ui-release"
        },
        {
            "name": "h755-debug",
            "configurePreset": "h755-debug"
        },
        {
            "name": "h755-release",
            "configurePreset": "h755-release"
        }
    ],
    "testPresets": [
        {
            "name": "sanitize-linux",
            "configurePreset": "sanitize-linux",
            "environment": {
                "ASAN_OPTIONS": "use_sigaltstack=0",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
