{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "base-linux",
            "hidden": true,
            "inherits": "base"
        },
        {
            "name": "debug-linux",
            "displayName": "Debug Linux",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-tidy-linux",
            "displayName": "Clang-Tidy Linux (partial coverage)",
            "inherits": "debug-linux"
        },
        {
            "name": "release-linux",
            "displayName": "Release Linux",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "sanitize-linux",
            "displayName": "Linux Address/Undefined Behavior Sanitizers",
            "inherits": "debug-linux",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
            }
        },
        {
            "name": "giga-io-debug",
            "displayName": "Arduino GIGA CM4 IO application (debug)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "STM32_CORE": "CM4",
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "giga-ui-debug",
            "displayName": "Arduino GIGA CM7 UI application (debug)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "STM32_CORE": "CM7",
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "giga-io-release",
            "displayName": "Arduino GIGA CM4 IO application (release)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "STM32_CORE": "CM4",
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "giga-ui-release",
            "displayName": "Arduino GIGA CM7 UI application (release)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "STM32_CORE": "CM7",
                "RUNTIME_FILESYSTEM": true
            }
        },
        {
            "name": "giga-debug",
            "displayName": "Arduino GIGA IO + UI applications (debug)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "GIGA_BUILD_BOTH": true
            }
        },
        {
            "name": "giga-release",
            "displayName": "Arduino GIGA IO + UI applications (release)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GIGA_BUILD_BOTH": true
            }
        },
        {
            "name": "giga-io-ram-debug",
            "inherits": "giga-io-debug",
            "cacheVariables": {
                "GIGA_M4_RAM_DEBUG": true
            }
        },
        {
            "name": "giga-ram-debug",
            "inherits": "giga-debug",
            "cacheVariables": {
                "GIGA_M4_RAM_DEBUG": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-linux",
            "configurePreset": "debug-linux"
        },
        {
            "name": "clang-tidy-linux",
            "configurePreset": "clang-tidy-linux",
            "targets": [
                "clang-tidy"
            ]
        },
        {
            "name": "release-linux",
            "configurePreset": "release-linux"
        },
        {
            "name": "sanitize-linux",
            "configurePreset": "sanitize-linux"
        },
        {
            "name": "giga-io-debug",
            "configurePreset": "giga-io-debug"
        },
        {
            "name": "giga-ui-debug",
            "configurePreset": "giga-ui-debug"
        },
        {
            "name": "giga-io-release",
            "configurePreset": "giga-io-release"
        },
        {
            "name": "giga-ui-release",
            "configurePreset": "giga-ui-release"
        },
        {
            "name": "giga-debug",
            "configurePreset": "giga-debug"
        },
        {
            "name": "giga-release",
            "configurePreset": "giga-release"
        },
        {
            "name": "giga-io-ram-debug",
            "configurePreset": "giga-io-ram-debug"
        },
        {
            "name": "giga-ram-debug",
            "configurePreset": "giga-ram-debug"
        }
    ],
    "testPresets": [
        {
            "name": "sanitize-linux",
            "configurePreset": "sanitize-linux",
            "environment": {
                "ASAN_OPTIONS": "use_sigaltstack=0",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
