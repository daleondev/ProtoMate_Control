{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "H755 IO Debug",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/h755-io-debug/io-controller.elf",
            "loadFiles": [],
            "device": "STM32H755ZI",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "configFiles": [
                "${workspaceFolder}/cmake/openocd/nucleo-h755ziq.cfg"
            ],
            "searchDir": [
                "/usr/share/openocd/scripts"
            ],
            "preLaunchTask": "H755 Debug Prerequisites",
            "rtos": "ThreadX",
            "showDevDebugOutput": "none",
            "numberOfProcessors": 2,
            "targetProcessor": 1
        },
        {
            "name": "H755 UI Debug",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/h755-ui-debug/ui-controller.elf",
            "loadFiles": [],
            "device": "STM32H755ZI",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "arm-none-eabi-gdb",
            "configFiles": [
                "${workspaceFolder}/cmake/openocd/nucleo-h755ziq.cfg"
            ],
            "searchDir": [
                "/usr/share/openocd/scripts"
            ],
            "preLaunchTask": "H755 Debug Prerequisites",
            "rtos": "ThreadX",
            "showDevDebugOutput": "none",
            "numberOfProcessors": 2,
            "targetProcessor": 0
        },
        {
            "name": "Linux Simulation Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug-linux/Application",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "Build Debug Linux",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass ThreadX suspend signal",
                    "text": "handle SIGUSR1 nostop noprint pass",
                    "ignoreFailures": true
                },
                {
                    "description": "Pass ThreadX resume signal",
                    "text": "handle SIGUSR2 nostop noprint pass",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
