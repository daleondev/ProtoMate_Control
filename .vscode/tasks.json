{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build H755 Debug",
            "type": "shell",
            "command": "cmake --preset h755-debug && cmake --build --preset h755-debug",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Flash H755 Debug",
            "type": "shell",
            "command": "openocd -f cmake/openocd/nucleo-h755ziq.cfg -c \"init; reset halt; targets stm32h7x.cpu0\" -c \"flash write_image erase build/h755-ui-debug/ui-controller.elf\" -c \"verify_image build/h755-ui-debug/ui-controller.elf\" -c \"flash write_image erase build/h755-io-debug/io-controller.elf\" -c \"verify_image build/h755-io-debug/io-controller.elf\" -c \"reset run; shutdown\"",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug Linux",
            "type": "shell",
            "command": "cmake --preset debug-linux && cmake --build --preset debug-linux",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "H755 Debug Prerequisites",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build H755 Debug",
                "Flash H755 Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Test Linux",
            "type": "shell",
            "command": "ctest --test-dir build/debug-linux --output-on-failure",
            "dependsOn": "Build Debug Linux",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
